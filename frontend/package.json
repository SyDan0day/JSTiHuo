{
  "name": "jstihuo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "generate": "openapi-typescript ../docs/development/openapi.yaml -o src/api/generated/schema.d.ts",
    "contract": "redocly lint ../docs/development/openapi.yaml"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.0.3",
    "pinia": "3.0.4",
    "element-plus": "2.13.6"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "openapi-typescript": "7.13.0",
    "@redocly/cli": "2.62.1"
  }
}
