FROM golang:1.26.1-alpine AS build
WORKDIR /src
COPY backend/go.* ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -o /api ./cmd/api && CGO_ENABLED=0 go build -o /migrate ./cmd/migrate && CGO_ENABLED=0 go build -o /admin ./cmd/admin && CGO_ENABLED=0 go build -o /worker ./cmd/worker
FROM alpine:3.23
RUN apk add --no-cache su-exec && adduser -D -u 10001 app
COPY --from=build /api /migrate /admin /worker /usr/local/bin/
COPY deployments/entrypoint.sh /usr/local/bin/start-app
ENTRYPOINT ["sh", "/usr/local/bin/start-app"]
CMD ["api"]
