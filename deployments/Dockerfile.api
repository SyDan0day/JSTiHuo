FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS build
WORKDIR /src
COPY backend/go.* ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -o /api ./cmd/api && CGO_ENABLED=0 go build -o /migrate ./cmd/migrate && CGO_ENABLED=0 go build -o /admin ./cmd/admin && CGO_ENABLED=0 go build -o /worker ./cmd/worker && CGO_ENABLED=0 go build -o /recovery ./cmd/recovery
FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk add --no-cache su-exec && adduser -D -u 10001 app
COPY --from=build /api /migrate /admin /worker /recovery /usr/local/bin/
COPY deployments/entrypoint.sh /usr/local/bin/start-app
ENTRYPOINT ["sh", "/usr/local/bin/start-app"]
CMD ["api"]
